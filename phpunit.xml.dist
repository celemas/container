<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.0/phpunit.xsd"
	bootstrap="vendor/autoload.php"
	colors="true"
	failOnWarning="true"
	cacheDirectory=".phpunit.cache">
	<testsuites>
		<testsuite name="Celema Container Test Suite">
			<directory suffix="Test.php">tests</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory>src</directory>
		</include>
	</source>
	<coverage includeUncoveredFiles="true">
		<report>
			<clover outputFile=".coverage/coverage.xml"/>
			<html outputDirectory=".coverage/html"/>
			<php outputFile=".coverage/coverage.php"/>
			<text outputFile="php://stdout"/>
			<!-- Infection reuses the XML coverage and JUnit log from .infection/coverage in CI -->
			<xml outputDirectory=".infection/coverage/coverage-xml"/>
		</report>
	</coverage>
	<logging>
		<junit outputFile=".infection/coverage/junit.xml"/>
	</logging>
</phpunit>
