{
	"name": "celema/container",
	"description": "A PSR-11 compatible dependency injection library",
	"keywords": [
		"di",
		"dependency injection",
		"container",
		"ioc",
		"psr-11",
		"psr11"
	],
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Ernst",
			"email": "ernst@celema.dev"
		}
	],
	"homepage": "https://celema.dev/container",
	"require": {
		"php": "^8.5",
		"celema/wire": "^0.8",
		"psr/container": "^2.0"
	},
	"require-dev": {
		"carthage-software/mago": "1.50.0",
		"ernst/coverlyzer": "^0.3",
		"infection/infection": "0.35.6",
		"phpunit/phpunit": "^13.0",
		"vimeo/psalm": "6.19.0"
	},
	"autoload": {
		"psr-4": {
			"Celema\\Container\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Celema\\Container\\Tests\\": "tests"
		}
	},
	"scripts": {
		"test": "./vendor/bin/phpunit --testdox --no-coverage --colors=always",
		"docstest": "for file in docs/code/*.php; do php \"$file\" || { echo \"Failed: $file\"; exit 1; }; done",
		"types": "./vendor/bin/psalm --no-cache",
		"docs:format": "npx prettier@3.6.2 --write --config ./docs/.prettierrc README.md CHANGELOG.md LICENSE.md docs/",
		"docs:lint": "npx markdownlint-cli2@0.22.1 README.md CHANGELOG.md LICENSE.md docs/",
		"lint": [
			"./vendor/bin/mago fmt --check",
			"./vendor/bin/mago lint"
		],
		"coverage:test": "php -d xdebug.mode=coverage ./vendor/bin/phpunit --testdox --path-coverage --colors=always",
		"coverage:analyze": "./vendor/bin/coverlyzer .coverage/coverage.php",
		"coverage": [
			"composer coverage:test",
			"composer coverage:analyze"
		],
		"ci": [
			"composer lint",
			"composer docstest",
			"composer coverage",
			"composer types"
		],
		"ci:full": [
			"composer ci",
			"composer docs:lint"
		],
		"mutation": [
			"Composer\\Config::disableProcessTimeout",
			"@putenv XDEBUG_MODE=coverage",
			"./vendor/bin/infection --threads=max"
		]
	},
	"config": {
		"allow-plugins": {
			"infection/extension-installer": true
		}
	}
}
